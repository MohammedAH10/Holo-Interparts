{
  "name": "gesture-agent-3d",
  "private": true,
  "version": "2.4.0",
  "description": "HoloHand - hand-controlled translucent CAD assembly (MediaPipe + Three.js)",
  "type": "module",
  "scripts": {
    "dev": "vite --open",
    "dev:all": "node scripts/dev.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "server": "node server/index.mjs",
    "dev:server": "node --watch server/index.mjs",
    "start": "node server/index.mjs",
    "test": "node --test test/*.test.mjs",
    "postinstall": "node scripts/setup.mjs"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.14",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "vite": "^5.4.0"
  }
}
